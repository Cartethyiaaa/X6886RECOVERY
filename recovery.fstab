# Android fstab file.
# The filesystem that contains the setup-specific mount points.
# <mount_point>       <fs_type>    <device>                                    <flags>

# Dynamic Partitions
/system_root          erofs        system                                      flags=display="System";logical;slotselect
/system_ext           erofs        system_ext                                  flags=display="System_EXT";logical;slotselect
/vendor               erofs        vendor                                      flags=display="Vendor";logical;slotselect
/product              erofs        product                                     flags=display="Product";logical;slotselect
/odm                  erofs        odm                                         flags=display="ODM";logical;slotselect
/vendor_dlkm          erofs        vendor_dlkm                                 flags=display="Vendor DLKM";logical;slotselect
/odm_dlkm             erofs        odm_dlkm                                    flags=display="ODM DLKM";logical;slotselect
/system_dlkm          erofs        system_dlkm                                 flags=display="System DLKM";logical;slotselect

# Transsion Dynamic Partitions
/tr_region            erofs        tr_region                                   flags=display="Transsion Region";logical;slotselect
/tr_company           erofs        tr_company                                  flags=display="Transsion Company";logical;slotselect
/tr_carrier           erofs        tr_carrier                                  flags=display="Transsion Carrier";logical;slotselect
/tr_product           erofs        tr_product                                  flags=display="Transsion Product";logical;slotselect
/tr_preload           erofs        tr_preload                                  flags=display="Transsion Preload";logical;slotselect
/tr_overlayfs         erofs        tr_overlayfs                                flags=display="Transsion OverlayFS";logical;slotselect
/tr_misc              erofs        tr_misc                                     flags=display="Transsion Misc";logical;slotselect
/tr_manifest          erofs        tr_manifest                                 flags=display="Transsion Manifest";logical;slotselect

# Physical Core Partitions
/metadata             ext4         /dev/block/by-name/metadata                 flags=display="Metadata"
/data                 f2fs         /dev/block/by-name/userdata                 flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/tranfs               ext4         /dev/block/by-name/tranfs                   flags=display="TranFS"

# Boot & Recovery Partitions
/boot                 emmc         /dev/block/by-name/boot                     flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot            emmc         /dev/block/by-name/init_boot                flags=display="Init Boot";backup=1;flashimg=1
/vendor_boot          emmc         /dev/block/by-name/vendor_boot              flags=display="Vendor Boot";backup=1;flashimg=1
/dtbo                 emmc         /dev/block/by-name/dtbo                     flags=display="DTBO";backup=1;flashimg=1
/odmdtbo              emmc         /dev/block/by-name/odmdtbo                  flags=display="ODM DTBO";backup=1;flashimg=1
/vbmeta               emmc         /dev/block/by-name/vbmeta                   flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system        emmc         /dev/block/by-name/vbmeta_system            flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor        emmc         /dev/block/by-name/vbmeta_vendor            flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

# MediaTek Calibration & Protected Partitions
/nvram                emmc         /dev/block/by-name/nvram                    flags=display="NVRAM";backup=1
/nvdata               ext4         /dev/block/by-name/nvdata                   flags=display="NVDATA";backup=1
/nvcfg                ext4         /dev/block/by-name/nvcfg                    flags=display="NVCFG";backup=1
/proinfo              emmc         /dev/block/by-name/proinfo                  flags=display="Proinfo"
/protect_f            ext4         /dev/block/by-name/protect1                 flags=display="Protect F";backup=1
/protect_s            ext4         /dev/block/by-name/protect2                 flags=display="Protect S";backup=1
/persist              ext4         /dev/block/by-name/persist                  flags=display="Persist";backup=1
/persistent           emmc         /dev/block/by-name/frp                      flags=display="FRP";backup=1

# Bootloader / Firmware Partitions
/bootloader           emmc         /dev/block/by-name/lk                       flags=display="Bootloader (LK)";backup=1
/bootloader2          emmc         /dev/block/by-name/lk2                      flags=display="Bootloader2 (LK2)";backup=1
/logo                 emmc         /dev/block/by-name/logo                     flags=display="Logo";backup=1;flashimg=1
/misc                 emmc         /dev/block/by-name/misc                     flags=display="Misc"
/para                 emmc         /dev/block/by-name/para                     flags=display="Para"
/expdb                emmc         /dev/block/by-name/expdb                    flags=display="ExpDB"
/seccfg               emmc         /dev/block/by-name/seccfg                   flags=display="SecCFG"
/tee1                 emmc         /dev/block/by-name/tee1                     flags=display="TEE1";backup=1
/tee2                 emmc         /dev/block/by-name/tee2                     flags=display="TEE2";backup=1
/scp1                 emmc         /dev/block/by-name/scp1                     flags=display="SCP1";backup=1
/scp2                 emmc         /dev/block/by-name/scp2                     flags=display="SCP2";backup=1
/sspm1                emmc         /dev/block/by-name/sspm1                    flags=display="SSPM1";backup=1
/sspm2                emmc         /dev/block/by-name/sspm2                    flags=display="SSPM2";backup=1
/dpm1                 emmc         /dev/block/by-name/dpm1                     flags=display="DPM1";backup=1
/dpm2                 emmc         /dev/block/by-name/dpm2                     flags=display="DPM2";backup=1
/mcupm1               emmc         /dev/block/by-name/mcupm1                   flags=display="MCUPM1";backup=1
/mcupm2               emmc         /dev/block/by-name/mcupm2                   flags=display="MCUPM2";backup=1
/md1img               emmc         /dev/block/by-name/md1img                   flags=display="MD1IMG";backup=1
/spmfw                emmc         /dev/block/by-name/spmfw                    flags=display="SPMFW";backup=1
/pi_img               emmc         /dev/block/by-name/pi_img                   flags=display="PI_IMG";backup=1
/boot_para            emmc         /dev/block/by-name/boot_para                flags=display="Boot Para"
/otp                  emmc         /dev/block/by-name/otp                      flags=display="OTP"
/tkv                  emmc         /dev/block/by-name/tkv                      flags=display="TKV"

# External & Removable Storage
/external_sd          auto         /dev/block/mmcblk1p1 /dev/block/mmcblk1     flags=display="Micro SD Card";storage;wipeingui;removable
/usb_otg              vfat         /dev/block/sdd1 /dev/block/sdd              flags=display="USB OTG";storage;wipeingui;removable
